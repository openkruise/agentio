{
  {{- if .LogAsJSON }}
  "application_log_config": {"log_format": {"json_format": {
    "time": "%Y-%m-%dT%T.%fZ", "level": "%l", "scope": "envoy %n", "msg": "%j", "caller": "%g:%#", "thread": "%t"
  }}},
  {{- end }}
  "node": {"id": {{json .NodeID}}, "cluster": {{json .ServiceCluster}}, "metadata": {{json .Metadata}}},
  "admin": {"address": {"socket_address": {"address": {{json .Localhost}}, "port_value": 15000}}},
  "deferred_stat_options": {"enable_deferred_creation_stats": true},
  "cluster_manager": {"enable_deferred_cluster_creation": true},
  "layered_runtime": {"layers": [
    {"name": "agentio", "static_layer": {
      "re2.max_program_size.error_level": 32768,
      "envoy.reloadable_features.enable_send_rst_on_user_space_socket": false
    }},
    {"name": "admin", "admin_layer": {}}
  ]},
  "stats_config": {"stats_tags": [{"tag_name": "response_code", "regex": "^agentio_gateway[.](?:istio_requests_total)([.]response_code[.]([0-9]+))$"}]},
  "stats_flush_interval": {{json .StatsFlushInterval}},
  "bootstrap_extensions": [{"name": "envoy.bootstrap.internal_listener", "typed_config": {
    "@type": "type.googleapis.com/envoy.extensions.bootstrap.internal_listener.v3.InternalListener", "buffer_size_kb": 64
  }}],
  "dynamic_resources": {
    "lds_config": {"ads": {}, "resource_api_version": "V3", "initial_fetch_timeout": "0s"},
    "cds_config": {"ads": {}, "resource_api_version": "V3", "initial_fetch_timeout": "0s"},
    "ads_config": {"api_type": "DELTA_GRPC", "transport_api_version": "V3", "set_node_on_first_message_only": true,
      "grpc_services": [{"envoy_grpc": {"cluster_name": "xds-grpc"}}]}
  },
  "static_resources": {
    "clusters": [
      {"name": "xds-grpc", "connect_timeout": "1s", "type": "STATIC",
       "typed_extension_protocol_options": {"envoy.extensions.upstreams.http.v3.HttpProtocolOptions": {
         "@type": "type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions", "explicit_http_config": {"http2_protocol_options": {}}}},
       "load_assignment": {"cluster_name": "xds-grpc", "endpoints": [{"lb_endpoints": [{"endpoint": {"address": {"pipe": {"path": {{json .XDSSocket}}}}}}]}]}},
      {"name": "sds-grpc", "connect_timeout": "1s", "type": "STATIC",
       "typed_extension_protocol_options": {"envoy.extensions.upstreams.http.v3.HttpProtocolOptions": {
         "@type": "type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions", "explicit_http_config": {"http2_protocol_options": {}}}},
       "load_assignment": {"cluster_name": "sds-grpc", "endpoints": [{"lb_endpoints": [{"endpoint": {"address": {"pipe": {"path": {{json .SDSSocket}}}}}}]}]}},
      {"name": "prometheus_stats", "connect_timeout": "0.250s", "type": "STATIC",
       "load_assignment": {"cluster_name": "prometheus_stats", "endpoints": [{"lb_endpoints": [{"endpoint": {"address": {"socket_address": {"address": {{json .Localhost}}, "port_value": 15000}}}}]}]}},
      {"name": "agent", "connect_timeout": "0.250s", "type": "STATIC",
       "load_assignment": {"cluster_name": "agent", "endpoints": [{"lb_endpoints": [{"endpoint": {"address": {"socket_address": {"address": {{json .Localhost}}, "port_value": 15020}}}}]}]}}
    ],
    "listeners": [
      {"name": "agentio_status", "stat_prefix": "agentio_status", "address": {"socket_address": {"address": {{json .Wildcard}}, "port_value": 15021}},
       "filter_chains": [{"filters": [{"name": "envoy.filters.network.http_connection_manager", "typed_config": {
         "@type": "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager",
         "stat_prefix": "agentio_status", "route_config": {"name": "status", "virtual_hosts": [{"name": "status", "domains": ["*"],
           "routes": [{"match": {"path": "/healthz/ready"}, "route": {"cluster": "agent", "timeout": "15s"}}]}]},
         "http_filters": [{"name": "envoy.filters.http.router", "typed_config": {"@type": "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"}}]
       }}]}]},
      {"name": "agentio_metrics", "stat_prefix": "agentio_metrics", "address": {"socket_address": {"address": {{json .Wildcard}}, "port_value": 15090}},
       "filter_chains": [{"filters": [{"name": "envoy.filters.network.http_connection_manager", "typed_config": {
         "@type": "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager",
         "stat_prefix": "agentio_metrics", "route_config": {"name": "metrics", "virtual_hosts": [{"name": "metrics", "domains": ["*"],
           "routes": [{"match": {"path": "/stats/prometheus"}, "route": {"cluster": "prometheus_stats", "timeout": "15s"}}]}]},
         "http_filters": [{"name": "envoy.filters.http.router", "typed_config": {"@type": "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"}}]
       }}]}]}
    ]
  }
}
