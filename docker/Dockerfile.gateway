# syntax=docker/dockerfile:1
# Copyright 2026 The Kruise Authors
ARG ENVOY_IMAGE=docker.io/envoyproxy/envoy:v1.40.2@sha256:8de97e654644827d62afdbf7e1d3dc9fee01a8690d410dd1c63a30dc6b6cecbb
FROM rust:1.93.0-bookworm AS metrics-builder
WORKDIR /src
COPY extensions/envoy/gateway-metrics/ ./
RUN cargo build --release --locked --offline

FROM scratch AS metrics-artifact
COPY --from=metrics-builder /src/target/release/libagentio_gateway_metrics.so /libagentio_gateway_metrics.so

FROM rust:1.93.0-bookworm AS sni-builder
RUN apt-get update && apt-get install -y --no-install-recommends clang libclang-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY extensions/envoy/sni-policy/ ./
RUN rustup component add rustfmt && bash build.sh

FROM sni-builder AS network-limits-builder
WORKDIR /network-limits
COPY --from=sni-builder /src/.envoy-sdk/ ./.envoy-sdk/
COPY extensions/envoy/network-limits/ ./
RUN bash build.sh

FROM --platform=$BUILDPLATFORM golang:1.26.8 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG AGENT_VERSION=dev
ARG AGENT_REVISION=unknown
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -trimpath -ldflags="-s -w -X github.com/openkruise/agentio/pkg/gatewayagent.Version=${AGENT_VERSION} -X github.com/openkruise/agentio/pkg/gatewayagent.Revision=${AGENT_REVISION}" -o /out/gateway-agent ./cmd/gateway-agent
FROM ${ENVOY_IMAGE} AS community
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /
COPY --from=builder /out/gateway-agent /usr/local/bin/gateway-agent
COPY --from=metrics-builder /src/target/release/libagentio_gateway_metrics.so /usr/local/lib/libagentio_gateway_metrics.so
COPY --from=sni-builder /src/target/release/libenvoy_agentio_sni_policy.so /usr/local/lib/libenvoy_agentio_sni_policy.so
COPY --from=network-limits-builder /network-limits/target/release/libenvoy_agentio_network_limits.so /usr/local/lib/libenvoy_agentio_network_limits.so
COPY LICENSE NOTICE /usr/share/doc/agentio-gateway/
USER 1337:1337
ENTRYPOINT ["/usr/local/bin/gateway-agent"]
CMD []
