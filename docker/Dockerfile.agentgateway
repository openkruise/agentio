FROM rust:1.99.0-trixie AS builder
RUN apt-get update && apt-get install -y --no-install-recommends clang cmake protobuf-compiler && rm -rf /var/lib/apt/lists/*
COPY extensions/agentgateway/ /agentio/extensions/agentgateway/
COPY extensions/envoy/sni-policy/src/policy.rs /agentio/extensions/envoy/sni-policy/src/policy.rs
WORKDIR /src
RUN git init && git remote add origin https://github.com/agentgateway/agentgateway.git \
    && git fetch --depth=1 origin "$(cat /agentio/extensions/agentgateway/source-revision)" \
    && git checkout --detach FETCH_HEAD \
    && bash /agentio/extensions/agentgateway/prepare.sh /src
ARG AGENT_VERSION=dev
ARG AGENT_REVISION=unknown
ARG TARGETARCH
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/target \
    if [ "$TARGETARCH" = arm64 ]; then export JEMALLOC_SYS_WITH_LG_PAGE=16; fi; \
    VERSION="1.7.0-agentio.${AGENT_VERSION}" GIT_REVISION="$AGENT_REVISION" \
    cargo build --release --locked -p agentgateway-app \
    && install -D target/release/agentgateway /out/agentgateway \
    && /out/agentgateway --version

FROM cr.agentgateway.dev/agentgateway:v1.7.0
COPY --from=builder /out/agentgateway /app/agentgateway
COPY LICENSE NOTICE /usr/share/doc/agentio-agentgateway/
LABEL org.opencontainers.image.source=https://github.com/openkruise/agentio
ENTRYPOINT ["/app/agentgateway"]
