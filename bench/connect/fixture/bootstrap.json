{
  "admin": {
    "address": {
      "socket_address": {
        "address": "127.0.0.1",
        "port_value": 17901
      }
    }
  },
  "static_resources": {
    "listeners": [
      {
        "name": "connect",
        "address": {
          "socket_address": {
            "address": "127.0.0.1",
            "port_value": 17902
          }
        },
        "per_connection_buffer_limit_bytes": 32768,
        "filter_chains": [
          {
            "filters": [
              {
                "name": "envoy.filters.network.http_connection_manager",
                "typed_config": {
                  "@type": "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager",
                  "stat_prefix": "connect",
                  "codec_type": "AUTO",
                  "stream_idle_timeout": "0s",
                  "internal_address_config": {
                    "cidr_ranges": [
                      {
                        "address_prefix": "127.0.0.1",
                        "prefix_len": 32
                      }
                    ]
                  },
                  "http2_protocol_options": {
                    "allow_connect": true,
                    "initial_stream_window_size": 65535,
                    "max_concurrent_streams": 1024
                  },
                  "upgrade_configs": [
                    {
                      "upgrade_type": "CONNECT"
                    }
                  ],
                  "route_config": {
                    "name": "connect",
                    "virtual_hosts": [
                      {
                        "name": "all",
                        "domains": [
                          "*"
                        ],
                        "routes": [
                          {
                            "match": {
                              "connect_matcher": {},
                              "headers": [
                                {
                                  "name": ":authority",
                                  "exact_match": "plain:80"
                                }
                              ]
                            },
                            "route": {
                              "cluster": "plain",
                              "timeout": "0s",
                              "upgrade_configs": [
                                {
                                  "upgrade_type": "CONNECT",
                                  "connect_config": {}
                                }
                              ]
                            }
                          },
                          {
                            "match": {
                              "connect_matcher": {},
                              "headers": [
                                {
                                  "name": ":authority",
                                  "exact_match": "tls:443"
                                }
                              ]
                            },
                            "route": {
                              "cluster": "tls",
                              "timeout": "0s",
                              "upgrade_configs": [
                                {
                                  "upgrade_type": "CONNECT",
                                  "connect_config": {}
                                }
                              ]
                            }
                          }
                        ]
                      }
                    ]
                  },
                  "http_filters": [
                    {
                      "name": "envoy.filters.http.set_filter_state",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.set_filter_state.v3.Config",
                        "on_request_headers": [
                          {
                            "object_key": "tenant.id",
                            "factory_key": "envoy.hashable_string",
                            "skip_if_empty": true,
                            "format_string": {
                              "text_format_source": {
                                "inline_string": "%REQ(x-tenant)%"
                              },
                              "omit_empty_values": true
                            }
                          },
                          {
                            "object_key": "agentio.sandbox.id",
                            "factory_key": "envoy.hashable_string",
                            "skip_if_empty": true,
                            "format_string": {
                              "text_format_source": {
                                "inline_string": "%REQ(x-sandbox)%"
                              },
                              "omit_empty_values": true
                            }
                          }
                        ]
                      }
                    },
                    {
                      "name": "agentio.bandwidth",
                      "typed_config": {
                        "@type": "type.googleapis.com/udpa.type.v1.TypedStruct",
                        "type_url": "type.googleapis.com/envoy.extensions.filters.http.dynamic_modules.v3.DynamicModuleFilter",
                        "value": {
                          "dynamic_module_config": {
                            "name": "envoy_agentio_network_limits",
                            "do_not_close": true,
                            "module": {
                              "local": {
                                "filename": "/usr/local/lib/libenvoy_agentio_network_limits.so"
                              }
                            }
                          },
                          "filter_name": "envoy_agentio_bandwidth",
                          "filter_config": {
                            "@type": "type.googleapis.com/google.protobuf.Struct",
                            "value": {
                              "budget_name": "smoke",
                              "buffer_limit_bytes": 32768,
                              "max_dynamic_buckets": 32,
                              "rate_limits": [
                                {
                                  "actions": [
                                    {
                                      "filter_state": {
                                        "key": "tenant.id",
                                        "descriptor_key": "tenant"
                                      }
                                    },
                                    {
                                      "filter_state": {
                                        "key": "agentio.sandbox.id",
                                        "descriptor_key": "sandbox"
                                      }
                                    }
                                  ]
                                }
                              ],
                              "descriptors": [
                                {
                                  "entries": [
                                    {
                                      "key": "tenant"
                                    },
                                    {
                                      "key": "sandbox"
                                    }
                                  ],
                                  "bandwidth_limit": {
                                    "upload_bytes_per_second": "131072",
                                    "download_bytes_per_second": "131072"
                                  }
                                },
                                {
                                  "entries": [
                                    {
                                      "key": "tenant",
                                      "value": "vip"
                                    },
                                    {
                                      "key": "sandbox",
                                      "value": "fast"
                                    }
                                  ],
                                  "bandwidth_limit": {
                                    "upload_bytes_per_second": 8388608,
                                    "download_bytes_per_second": 8388608
                                  }
                                }
                              ]
                            }
                          }
                        }
                      }
                    },
                    {
                      "name": "envoy.filters.http.router",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"
                      }
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ],
    "clusters": [
      {
        "name": "plain",
        "type": "STATIC",
        "connect_timeout": "1s",
        "per_connection_buffer_limit_bytes": 32768,
        "load_assignment": {
          "cluster_name": "plain",
          "endpoints": [
            {
              "lb_endpoints": [
                {
                  "endpoint": {
                    "address": {
                      "socket_address": {
                        "address": "127.0.0.1",
                        "port_value": 17900
                      }
                    }
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "name": "tls",
        "type": "STATIC",
        "connect_timeout": "1s",
        "per_connection_buffer_limit_bytes": 32768,
        "load_assignment": {
          "cluster_name": "tls",
          "endpoints": [
            {
              "lb_endpoints": [
                {
                  "endpoint": {
                    "address": {
                      "socket_address": {
                        "address": "127.0.0.1",
                        "port_value": 17900
                      }
                    }
                  }
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
